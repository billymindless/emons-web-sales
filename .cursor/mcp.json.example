{
  "mcpServers": {
    "momo-leads": {
      "command": "python3",
      "args": [
        "/ABS/PATH/TO/emons-web-sales/scripts/momo_leads_mcp.py"
      ],
      "env": {
        "LEAD_API_BASE_URL": "https://emons-sms-webhook.onrender.com",
        "LEAD_API_TOKEN": "REPLACE_WITH_LEAD_API_TOKEN"
      }
    }
  }
}
