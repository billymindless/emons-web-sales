# secrets.toml에 아래 섹션을 추가하세요.
# (실제 파일: .streamlit/secrets.toml)

[chat_app]
# Vercel 배포 후 실제 URL로 교체하세요.
url = "https://emons-chat.vercel.app"

# 행정안전부 행정동별 인구·세대 통계 API (상권 퍼포먼스 맵)
# data.go.kr 일반 인증키는 [elevator_api] 와 동일 키를 사용할 수 있습니다.
[population_api]
service_key = "YOUR_DATA_GO_KR_SERVICE_KEY"
endpoint = "https://apis.data.go.kr/1741000/admmPpltnHhStus/selectAdmmPpltnHhStus"
age_endpoint = "https://apis.data.go.kr/1741000/admmSexdAgePpltn/selectAdmmSexdAgePpltn"

# 국토교통부 아파트 매매 실거래가 (data.go.kr 15126469)
[apt_trade_api]
service_key = "YOUR_DATA_GO_KR_SERVICE_KEY"
endpoint = "https://apis.data.go.kr/1613000/RTMSDataSvcAptTrade/getRTMSDataSvcAptTrade"
